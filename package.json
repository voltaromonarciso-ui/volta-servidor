{
  "name": "volta-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST + WebSocket para la comunidad social de VOLTA",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
