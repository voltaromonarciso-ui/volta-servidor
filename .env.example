# Cadena de conexión de PostgreSQL. En Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=postgres://usuario:clave@localhost:5432/volta
# true para Supabase, Neon, Render… (exigen TLS)
PGSSL=false

# Mínimo 32 caracteres. Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES=7d
BCRYPT_ROUNDS=12

PORT=3000
# Orígenes permitidos separados por comas (vacío = cualquiera; en producción ponlo siempre)
CORS_ORIGINS=http://localhost:5500,https://tudominio.com
# 1 si el servidor está detrás de un proxy (Render, Railway, Nginx…) para que el límite por IP funcione
TRUST_PROXY=0
NODE_ENV=development

# ── Escalado (opcional) ──
# Redis compartido: avisos en tiempo real entre instancias y límites de peticiones comunes.
# Imprescindible con más de una instancia o con npm run start:cluster.
REDIS_URL=
# Procesos con start:cluster (vacío = uno por núcleo)
WEB_CONCURRENCY=
# Conexiones a PostgreSQL por proceso. Con PgBouncer delante puedes subirlo.
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=10000
